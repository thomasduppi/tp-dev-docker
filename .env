# Arguments de run de la stack (lus automatiquement par docker compose).
# Modifier une valeur puis : docker compose up -d

# --- Image de base -------------------------------------------------------
ALPINE_VERSION=3.21.3
ALPINE_ARCH=x86_64

# --- Backend (Python) ----------------------------------------------------
BACKEND_CPUS=0.50
BACKEND_MEMORY=128M
BACKEND_CPUS_RESERVED=0.10
BACKEND_MEMORY_RESERVED=32M
BACKEND_PIDS=64
BACKEND_PORT=8081
BACKEND_HISTORY_LIMIT=20
BACKEND_REQUEST_QUEUE_SIZE=64

# --- Frontend (React servi par nginx) ------------------------------------
FRONTEND_CPUS=0.25
FRONTEND_MEMORY=64M
FRONTEND_CPUS_RESERVED=0.05
FRONTEND_MEMORY_RESERVED=16M
FRONTEND_PIDS=32
FRONTEND_WORKER_PROCESSES=1
FRONTEND_WORKER_CONNECTIONS=256

# --- Serveur web (reverse proxy nginx) -----------------------------------
WEBSERVER_PUBLIC_PORT=8080
WEBSERVER_CPUS=0.50
WEBSERVER_MEMORY=64M
WEBSERVER_CPUS_RESERVED=0.05
WEBSERVER_MEMORY_RESERVED=16M
WEBSERVER_PIDS=32
WEBSERVER_WORKER_PROCESSES=2
WEBSERVER_WORKER_CONNECTIONS=512
WEBSERVER_CLIENT_MAX_BODY_SIZE=16k
WEBSERVER_API_RATE_LIMIT=20

# --- CI : lint & tests ---------------------------------------------------
LINT_CPUS=1.0
LINT_MEMORY=256M
LINT_PIDS=64
LINT_MAX_LINE_LENGTH=110
TESTS_CPUS=0.50
TESTS_MEMORY=128M
TESTS_PIDS=32
TESTS_TIMEOUT=5
